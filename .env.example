# Neon Serverless PostgreSQL Database Connection String
# Obtain your connection URI from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication (generate a secure random 32+ character string for production)
JWT_SECRET="your-secure-random-jwt-secret-here"

# Node Environment
NODE_ENV="development"
